INSTAGRAM_ENABLED=false
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# Required for newer Meta apps (Unified Login / Facebook Login for Business)
INSTAGRAM_CONFIG_ID=
# Must be HTTPS for Unified Login redirect registration (quick tunnel URL changes every restart)
INSTAGRAM_REDIRECT_URI=https://your-tunnel.example/api/v1/instagram/oauth/callback
INSTAGRAM_FRONTEND_SUCCESS_URL=http://localhost:4200/app/instagram
# Same public HTTPS host as tunnel — Meta fetches staged uploads from here
INSTAGRAM_PUBLIC_MEDIA_BASE_URL=https://your-tunnel.example
# Remote UI test (comma-separated). Example: http://localhost:4200,https://ui-xxx.trycloudflare.com
CORS_ALLOWED_ORIGINS=http://localhost:4200

# Local start (loads this file into process env — plain ./gradlew bootRun does NOT):
#   ./run-dev.sh
# Tunnel (separate terminal):
#   ../tools/cloudflared.exe tunnel --url http://localhost:8080

